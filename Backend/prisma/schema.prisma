// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  city         String
  college      String
  bio          String?
  contact      String?
  skills       String[]
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  hackathons   Hackathon[]
  ledTeams     Team[]       @relation("TeamLeader")
  memberships  TeamMember[]
  soloEntries  SoloEntry[]
  requestsAbout Request[] @relation("RequestAbout")
  requestsSent  Request[] @relation("RequestSender")
  reports      Report[]
}

enum Mode {
  ONLINE
  IN_PERSON
  HYBRID
}

model Hackathon {
  id          Int      @id @default(autoincrement())
  name        String
  organizer   String
  description String?
  link        String
  mode        Mode
  city        String?
  startDate   DateTime
  endDate     DateTime
  deadline    DateTime
  minTeamSize Int
  maxTeamSize Int
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  postedById  Int
  postedBy    User     @relation(fields: [postedById], references: [id])
  teams        Team[]
  teamMembers  TeamMember[]
  soloEntries  SoloEntry[]
  reports      Report[]
}

model Team {
  id           Int          @id @default(autoincrement())
  name         String
  skillsNeeded String[]
  spotsNeeded  Int
  createdAt    DateTime     @default(now())
  hackathonId  Int
  hackathon    Hackathon    @relation(fields: [hackathonId], references: [id])
  leaderId     Int
  leader       User         @relation("TeamLeader", fields: [leaderId], references: [id])
  members      TeamMember[]
  requests     Request[]
}

model TeamMember {
  id          Int       @id @default(autoincrement())
  joinedAt    DateTime  @default(now())
  teamId      Int
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  hackathonId Int
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id])

  @@unique([userId, hackathonId])
}

model SoloEntry {
  id          Int       @id @default(autoincrement())
  note        String?
  createdAt   DateTime  @default(now())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  hackathonId Int
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id])

  @@unique([userId, hackathonId])
}

enum RequestType {
  JOIN
  INVITE
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Request {
  id        Int           @id @default(autoincrement())
  type      RequestType
  status    RequestStatus @default(PENDING)
  message   String?
  createdAt DateTime      @default(now())
  teamId    Int
  team      Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    Int
  user      User          @relation("RequestAbout", fields: [userId], references: [id])
  senderId  Int
  sender    User          @relation("RequestSender", fields: [senderId], references: [id])
}

model Report {
  id          Int       @id @default(autoincrement())
  reason      String?
  createdAt   DateTime  @default(now())
  hackathonId Int
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, hackathonId])
}