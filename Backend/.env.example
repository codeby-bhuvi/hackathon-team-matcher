# Backend environment variables
# Copy this file to .env and fill in your values

# PostgreSQL connection string (use Render Internal Database URL in production)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT signing secret — use a long random string in production
JWT_SECRET=your-secret-here

# Number of reports before a hackathon post is auto-hidden
REPORT_THRESHOLD=2

# Your Vercel frontend URL — set this in Render's Environment panel
CLIENT_URL=https://your-frontend.vercel.app

# Server port (Render sets this automatically)
# PORT=5000
